            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.harri.com/open-api-hub/api/v1/locations/:location_id/school_templates",
            "params": [
              {
                "name": "location_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the location."
              }
            ]
          },
          "docs": "Retrieves a list of active school calendar templates for a specific location."
        },
        {
          "info": {
            "name": "List Minor Types",
