        {
          "info": {
            "name": "Get employees API",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.harri.com/open-api-hub/api/v3/employees",
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "to get terminated or active employee, default active"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "specify the number of rows to return"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "specify the number of rows to skip"
              },
              {
                "name": "location_id",
                "value": "",
                "type": "query",
                "description": "specify the location id to filter"
              },
              {
                "name": "is_primary",
                "value": "",
                "type": "query",
                "description": "retrieve primary employees of the provided location_id"
              },
              {
                "name": "loa_status",
                "value": "",
                "type": "query",
                "description": "Filters employees by active LOA (Leave of Absence) status. When provided, only employees currently marked as 'ON_LEAVE' within the retrieved page will be returned.\n"
              },
              {
                "name": "payroll_id",
                "value": "",
                "type": "query",
                "description": "filter employees by payroll_id"
              },
              {
                "name": "geid",
                "value": "",
                "type": "query",
                "description": "filter employees by geid (external middleware id)"
              }
            ]
          },
          "docs": "Get employees."
        },
